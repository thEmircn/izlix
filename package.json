{
  "name": "izlix",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "React-aware development browser",
  "main": "out/main/index.js",
  "scripts": {
    "dev": "env -u ELECTRON_RUN_AS_NODE electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "pack": "electron-vite build && CSC_IDENTITY_AUTO_DISCOVERY=false electron-builder --mac --dir -c.mac.target=dir",
    "dist": "electron-vite build && electron-builder --mac",
    "build:demo": "vite build -c samples/demo-src/vite.config.ts",
    "e2e": "electron-vite build && python3 tests/e2e/suite.py",
    "update-electron": "npm install electron@latest --save-exact=false && npm run build && npx vitest run",
    "build:ext": "node packages/extension/build.mjs",
    "test:ext": "node packages/extension/build.mjs && node packages/extension/tests/e2e.mjs",
    "typecheck:ext": "tsc --noEmit -p packages/extension"
  },
  "dependencies": {
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7",
    "zustand": "^5.1.0"
  },
  "devDependencies": {
    "@babel/parser": "^8.1.0",
    "@electron/fuses": "^2.1.3",
    "@jridgewell/trace-mapping": "^0.3.31",
    "@types/chrome": "^0.3.7",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.2.3",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "esbuild": "^0.28.2",
    "qrcode-generator": "^2.0.4",
    "typescript": "^7.0.2",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  },
  "bin": {
    "izlix": "bin/izlix.js"
  },
  "license": "Apache-2.0",
  "author": "Izlix contributors"
}
